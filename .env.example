# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Session Signing Secret (Disarankan isi string acak panjang di produksi agar sesi login tetap valid setelah restart)
SESSION_SECRET=""

# Web Push VAPID Keys (Opsional di lokal karena dibuat otomatis ke .data/, disarankan diisi di produksi/Cloud Run)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@personalcaretracker.local"

# Server-side Supabase Configuration (Opsional - aktifkan jika menghubungkan ke Supabase PostgreSQL & Storage)
# PENTING: Jangan pernah menggunakan prefix VITE_ untuk service role key agar tidak terkirim ke browser.
# Kosongkan jika ingin memakai penyimpanan lokal persisten bawaan (.data/).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
